# LOCAL DEVELOPMENT PLACEHOLDERS ONLY -- NOT FOR PRODUCTION.
# dev-up.ps1 creates deploy/.env with random local passwords when no .env exists.
# A project-root .env takes precedence over deploy/.env when both exist.

TZ=Asia/Shanghai

MYSQL_ROOT_PASSWORD=local-only-mysql-root-password-change-me
MYSQL_USER=secure_im
MYSQL_PASSWORD=local-only-mysql-user-password-change-me
MYSQL_PORT=13306

REDIS_PASSWORD=local-only-redis-password-change-me
REDIS_PORT=16379

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=local-only-minio-password-change-me
MINIO_API_PORT=19000
MINIO_CONSOLE_PORT=19001
