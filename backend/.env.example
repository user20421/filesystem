# Local development only. Export these variables before starting the server.
LISTEN_ADDR=127.0.0.1:8080
MYSQL_ADDR=127.0.0.1:13306
MYSQL_DATABASE=secure_im
MYSQL_USER=root
MYSQL_PASSWORD=change-me
# Alternatively set MYSQL_DSN, which takes precedence over MYSQL_* above.
# MYSQL_DSN=root:change-me@tcp(127.0.0.1:13306)/secure_im?parseTime=true
MINIO_ENDPOINT=127.0.0.1:19000
MINIO_ACCESS_KEY=change-me
MINIO_SECRET_KEY=change-me
MINIO_BUCKET=secure-im-files
MINIO_USE_SSL=false
# Required: at least 32 random bytes. Do not reuse these example values in production.
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes
# Required: base64 encoding of exactly 32 random bytes (for example, use openssl rand -base64 32).
FILE_KEK=replace-with-base64-encoded-32-byte-key
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
WS_TICKET_TTL=1m
WS_MAX_CONNECTIONS=1000
MAX_ACTIVE_FILES=3
MAX_CHUNK_SIZE=4194304
MAX_FILE_SIZE=5368709120
UPLOAD_CONCURRENCY=4
# Aggregate weighted plaintext/ciphertext chunk memory reservation, in bytes.
FILE_MEMORY_BUDGET=524288000
# Optional unauthenticated diagnostics; publish the listener on loopback only.
ENABLE_DEBUG_STATS=false
